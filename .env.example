# Server Configuration
PORT=8000
NODE_ENV=development

# Database Configuration (MongoDB Atlas Cloud or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?appName=Cluster0

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# Initial Admin Seed Credentials
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@personalcarebd.com
ADMIN_PHONE=01700000000
ADMIN_PASSWORD=admin123456

# CORS & Client URLs
CLIENT_URL=http://localhost:3000

# Render Deployment Self-Ping (Auto-detected on Render)
# RENDER_EXTERNAL_URL=https://your-api-url.onrender.com
