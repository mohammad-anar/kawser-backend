# ========================================================
# Express Backend Environment Variables (.env)
# ========================================================

# --- Server Configuration ---
PORT=8000
NODE_ENV=production

# --- MongoDB Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/kawser?appName=Cluster0

# --- JWT Authentication ---
JWT_SECRET=your_super_secret_jwt_key_here
JWT_RESET_SECRET=your_super_secret_reset_jwt_key_here

# --- CORS & Client URLs (Frontend domains) ---
CLIENT_URL=https://www.carezonebd.tech

# --- Initial Admin Seed Credentials ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PHONE=01700000000
ADMIN_PASSWORD=YourSecurePassword123

# --- Steadfast Courier API ---
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_SECRET_KEY=your_steadfast_secret_key
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_WEBHOOK_TOKEN=your_webhook_token

# --- Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Meta Conversions API (CAPI) ---
META_PIXEL_ID=995456930309440
META_ACCESS_TOKEN=your_meta_access_token_here
META_TEST_EVENT_CODE=
